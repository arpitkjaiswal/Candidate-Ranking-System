# Local development; never commit real access keys or applicant data.
TALENT_ENV=development
TALENT_DEMO=1
TALENT_DATA_DIR=/workspace/.talentos
# Production: set TALENT_ENV=production, TALENT_DEMO=0, and a 32+ character key.
# TALENT_API_KEY=
# Optional PostgreSQL (install psycopg[binary] separately):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/talentos
